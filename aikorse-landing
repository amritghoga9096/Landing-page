<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIKORSE — The World's First AI-Powered Stress Ball</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #070707;
    --bg2: #0e0e0e;
    --bg3: #141414;
    --fg: #f0ede8;
    --fg2: #a09d98;
    --fg3: #5a5753;
    --lime: oklch(0.88 0.22 128);
    --lime-dim: oklch(0.6 0.16 128);
    --lime-glow: oklch(0.88 0.22 128 / 0.12);
    --red: oklch(0.65 0.2 25);
    --border: rgba(240,237,232,0.07);
    --border2: rgba(240,237,232,0.12);
    --r: 4px;
    --font: 'Space Grotesk', sans-serif;
    --mono: 'DM Mono', monospace;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    font-size: 17px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* Noise overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: 0.6;
  }

  /* Nav */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 64px;
    border-bottom: 1px solid var(--border);
    background: rgba(7,7,7,0.85);
    backdrop-filter: blur(16px);
  }
  .nav-logo {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    color: var(--fg2);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--fg); }
  .nav-cta {
    background: var(--lime);
    color: #070707;
    border: none;
    padding: 8px 20px;
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--r);
    transition: opacity 0.2s;
  }
  .nav-cta:hover { opacity: 0.85; }

  /* Sections */
  section { position: relative; }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 40px 80px;
    overflow: hidden;
  }

  .hero-bg-glow {
    position: absolute;
    width: 700px; height: 700px;
    background: radial-gradient(circle, oklch(0.88 0.22 128 / 0.06) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: pulse-glow 4s ease-in-out infinite;
  }
  @keyframes pulse-glow {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
  }

  .hero-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--lime);
    border: 1px solid var(--lime-dim);
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 36px;
    display: inline-block;
    animation: fade-up 0.8s ease both;
  }

  .hero-title {
    font-size: clamp(60px, 11vw, 148px);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin-bottom: 12px;
    animation: fade-up 0.8s 0.1s ease both;
  }
  .hero-title span { color: var(--lime); }

  .hero-sub {
    font-size: clamp(16px, 2vw, 22px);
    color: var(--fg2);
    max-width: 520px;
    margin: 28px auto 0;
    font-weight: 400;
    line-height: 1.6;
    animation: fade-up 0.8s 0.2s ease both;
  }

  .hero-meta {
    margin-top: 48px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.15em;
    animation: fade-up 0.8s 0.35s ease both;
  }

  .hero-scroll {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.15em;
    animation: fade-up 0.8s 0.5s ease both;
  }
  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--fg3), transparent);
    animation: scroll-line 2s ease-in-out infinite;
  }
  @keyframes scroll-line {
    0% { transform: scaleY(0); transform-origin: top; opacity: 0; }
    50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
    100% { transform: scaleY(1); transform-origin: bottom; opacity: 0; }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── STATEMENT ── */
  #statement {
    padding: 140px 40px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .statement-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--lime);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .statement-text {
    font-size: clamp(30px, 4.5vw, 58px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .statement-text em { color: var(--fg2); font-style: normal; }

  /* ── MODEL ── */
  #model {
    padding: 100px 40px;
    background: var(--bg2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .model-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .model-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--lime);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .model-title {
    font-size: clamp(42px, 6vw, 80px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 20px;
  }
  .model-body { color: var(--fg2); font-size: 16px; line-height: 1.7; max-width: 420px; }
  .model-card {
    background: var(--bg3);
    border: 1px solid var(--border2);
    border-radius: 12px;
    padding: 40px;
    font-family: var(--mono);
  }
  .model-card-title {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--fg3);
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .model-stat {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .model-stat:last-child { border-bottom: none; }
  .model-stat-key { font-size: 12px; color: var(--fg3); }
  .model-stat-val { font-size: 14px; color: var(--lime); font-weight: 500; }

  /* ── FEATURES ── */
  #features {
    padding: 120px 40px;
    max-width: 1160px;
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: 80px;
  }
  .section-header h2 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .section-header p { color: var(--fg2); font-size: 16px; max-width: 480px; margin: 0 auto; }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .feature-card {
    padding: 44px 36px;
    background: var(--bg2);
    transition: background 0.3s;
    position: relative;
    overflow: hidden;
  }
  .feature-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--lime-glow);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .feature-card:hover { background: var(--bg3); }
  .feature-card:hover::after { opacity: 1; }
  .feature-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.15em;
    margin-bottom: 24px;
  }
  .feature-icon {
    width: 48px; height: 48px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .feature-icon svg { width: 32px; height: 32px; }
  .feature-card h3 {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 10px;
    letter-spacing: -0.02em;
  }
  .feature-card p { color: var(--fg2); font-size: 14px; line-height: 1.6; }
  .feature-tag {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--lime-dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── STATS ── */
  #stats {
    padding: 120px 40px;
    background: var(--bg2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .stats-inner { max-width: 1160px; margin: 0 auto; }
  .stats-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--lime);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 72px;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .stat-item {
    padding: 52px 36px;
    background: var(--bg2);
    text-align: center;
  }
  .stat-num {
    font-size: clamp(44px, 5vw, 72px);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--lime);
    display: block;
    line-height: 1;
    margin-bottom: 12px;
  }
  .stat-label { font-size: 13px; color: var(--fg3); font-family: var(--mono); letter-spacing: 0.1em; }

  /* ── INTERACTIVE ── */
  #interactive {
    padding: 120px 40px;
    max-width: 1160px;
    margin: 0 auto;
  }
  .interactive-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .interactive-title {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .interactive-body { color: var(--fg2); margin-bottom: 32px; line-height: 1.7; }
  .slider-group { margin-bottom: 24px; }
  .slider-header { display: flex; justify-content: space-between; margin-bottom: 8px; }
  .slider-key { font-size: 13px; color: var(--fg2); }
  .slider-val { font-family: var(--mono); font-size: 13px; color: var(--lime); }
  input[type=range] {
    -webkit-appearance: none;
    width: 100%; height: 2px;
    background: var(--border2);
    outline: none;
    border-radius: 2px;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--lime);
    cursor: pointer;
    box-shadow: 0 0 12px var(--lime-glow);
  }
  .score-display {
    background: var(--bg3);
    border: 1px solid var(--border2);
    border-radius: 12px;
    padding: 40px;
    text-align: center;
  }
  .score-big {
    font-size: 80px;
    font-weight: 700;
    color: var(--lime);
    letter-spacing: -0.05em;
    line-height: 1;
    font-family: var(--mono);
  }
  .score-label { color: var(--fg3); font-family: var(--mono); font-size: 12px; margin-top: 8px; letter-spacing: 0.15em; }
  .score-bar-wrap { margin-top: 28px; }
  .score-bar-track { height: 4px; background: var(--border); border-radius: 4px; overflow: hidden; }
  .score-bar-fill { height: 100%; background: var(--lime); border-radius: 4px; transition: width 0.4s; }

  /* ── TICKER ── */
  .ticker-section {
    padding: 28px 0;
    background: var(--lime);
    overflow: hidden;
    border-top: none;
  }
  .ticker-track {
    display: flex;
    gap: 0;
    animation: ticker 25s linear infinite;
    white-space: nowrap;
  }
  .ticker-item {
    color: #070707;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0 40px;
    flex-shrink: 0;
  }
  .ticker-sep { color: rgba(7,7,7,0.4); }
  @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ── TESTIMONIALS ── */
  #testimonials {
    padding: 120px 40px;
    background: var(--bg2);
    border-top: 1px solid var(--border);
  }
  .testimonials-header { text-align: center; margin-bottom: 72px; }
  .testimonials-header h2 {
    font-size: clamp(34px, 5vw, 60px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .rating-line {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg3);
    letter-spacing: 0.12em;
  }
  .rating-stars { color: var(--lime); margin-right: 8px; }
  .testimonials-grid {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .testimonial-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    transition: border-color 0.3s, transform 0.3s;
  }
  .testimonial-card:hover {
    border-color: var(--border2);
    transform: translateY(-4px);
  }
  .t-stars { color: var(--lime); font-size: 13px; margin-bottom: 16px; }
  .t-quote { font-size: 15px; line-height: 1.6; color: var(--fg); margin-bottom: 20px; }
  .t-author { display: flex; gap: 12px; align-items: center; }
  .t-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--border2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .t-name { font-size: 13px; font-weight: 600; }
  .t-role { font-size: 12px; color: var(--fg3); font-family: var(--mono); }
  .t-rating { margin-top: 12px; font-family: var(--mono); font-size: 11px; color: var(--lime); }

  /* ── PRODUCT TIERS ── */
  #pricing {
    padding: 120px 40px;
    max-width: 1160px;
    margin: 0 auto;
  }
  .pricing-header { text-align: center; margin-bottom: 72px; }
  .pricing-header h2 {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .tier-switcher {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 60px;
    border: 1px solid var(--border2);
    border-radius: 100px;
    padding: 4px;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }
  .tier-btn {
    background: transparent;
    border: none;
    color: var(--fg3);
    font-family: var(--font);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 24px;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.05em;
  }
  .tier-btn.active { background: var(--lime); color: #070707; }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pricing-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px 32px;
    transition: border-color 0.3s;
    position: relative;
  }
  .pricing-card.featured {
    border-color: var(--lime);
    background: var(--bg3);
  }
  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--lime);
    color: #070707;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 100px;
    white-space: nowrap;
  }
  .pricing-name { font-size: 13px; font-weight: 600; color: var(--fg2); letter-spacing: 0.1em; margin-bottom: 8px; text-transform: uppercase; font-family: var(--mono); }
  .pricing-price { font-size: 48px; font-weight: 700; letter-spacing: -0.04em; margin-bottom: 4px; }
  .pricing-desc { color: var(--fg3); font-size: 13px; margin-bottom: 32px; }
  .pricing-divider { height: 1px; background: var(--border); margin-bottom: 28px; }
  .pricing-feature { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; font-size: 14px; }
  .pricing-feature-check { color: var(--lime); flex-shrink: 0; margin-top: 2px; }
  .pricing-cta {
    display: block;
    width: 100%;
    text-align: center;
    padding: 14px;
    border-radius: 8px;
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 28px;
    border: 1px solid var(--border2);
    background: transparent;
    color: var(--fg);
    transition: all 0.2s;
    letter-spacing: 0.05em;
  }
  .pricing-card.featured .pricing-cta {
    background: var(--lime);
    border-color: var(--lime);
    color: #070707;
  }
  .pricing-cta:hover { opacity: 0.8; }

  /* ── TECH ── */
  #tech {
    padding: 120px 40px;
    background: var(--bg2);
    border-top: 1px solid var(--border);
  }
  .tech-inner {
    max-width: 1160px;
    margin: 0 auto;
  }
  .tech-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .tech-title {
    font-size: clamp(34px, 4.5vw, 54px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .tech-body { color: var(--fg2); line-height: 1.7; margin-bottom: 32px; }
  .tech-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tech-tag {
    border: 1px solid var(--border2);
    border-radius: 100px;
    padding: 6px 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg2);
    letter-spacing: 0.1em;
  }
  .tech-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px;
    font-family: var(--mono);
  }
  .tech-card-head {
    font-size: 11px;
    color: var(--fg3);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .tech-bar { margin-bottom: 20px; }
  .tech-bar-header { display: flex; justify-content: space-between; margin-bottom: 6px; }
  .tech-bar-key { font-size: 12px; color: var(--fg2); }
  .tech-bar-val { font-size: 12px; color: var(--lime); }
  .tech-bar-track { height: 3px; background: var(--border); border-radius: 3px; overflow: hidden; }
  .tech-bar-fill { height: 100%; background: linear-gradient(to right, var(--lime), oklch(0.88 0.22 180)); border-radius: 3px; }

  /* ── SOCIAL GRID ── */
  #social-grid {
    padding: 120px 40px;
    max-width: 1160px;
    margin: 0 auto;
  }
  .sg-title {
    font-size: clamp(30px, 4vw, 50px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }
  .sg-sub { color: var(--fg2); margin-bottom: 52px; }
  .sg-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    border-radius: 12px;
    overflow: hidden;
  }
  .sg-card {
    background: var(--bg2);
    padding: 32px 24px;
    border: 1px solid var(--border);
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.3s;
  }
