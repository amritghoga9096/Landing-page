<script>
  // ── Tweaks protocol ──
  window.addEventListener('message', e => {
    if (e.data?.type === '__activate_edit_mode') document.getElementById('tweaks-panel').style.display = 'block';
    if (e.data?.type === '__deactivate_edit_mode') document.getElementById('tweaks-panel').style.display = 'none';
  });
  window.parent.postMessage({type: '__edit_mode_available'}, '*');

  const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
    "accent": "oklch(0.88 0.22 128)",
    "bg": "#0f0a07",
    "noise": true,
    "ticker": true
  }/*EDITMODE-END*/;
  let tweaks = {...TWEAK_DEFAULTS};

  function applyTweaks() {
    const accent = document.getElementById('tw-accent').value;
    const bg = document.getElementById('tw-bg').value;
    document.documentElement.style.setProperty('--lime', accent);
    document.documentElement.style.setProperty('--bg', bg);
    tweaks.accent = accent;
    tweaks.bg = bg;
    document.getElementById('tw-accent-val').textContent = document.getElementById('tw-accent').selectedOptions[0].text;
    document.getElementById('tw-bg-val').textContent = document.getElementById('tw-bg').selectedOptions[0].text;
    window.parent.postMessage({type:'__edit_mode_set_keys', edits: tweaks}, '*');
  }

  function toggleNoise(btn) {
    btn.classList.toggle('on');
    const on = btn.classList.contains('on');
    document.body.style.setProperty('--noise-opacity', on ? '0.6' : '0');
    tweaks.noise = on;
    window.parent.postMessage({type:'__edit_mode_set_keys', edits: tweaks}, '*');
  }

  function toggleTicker(btn) {
    btn.classList.toggle('on');
    const on = btn.classList.contains('on');
    document.querySelector('.ticker-section').style.display = on ? '' : 'none';
    tweaks.ticker = on;
    window.parent.postMessage({type:'__edit_mode_set_keys', edits: tweaks}, '*');
  }

  // ── Scroll reveal ──
  const revealEls = document.querySelectorAll('.reveal');
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); } });
  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
  revealEls.forEach(el => revealObs.observe(el));

  // ── Counter animation ──
  const counterEls = document.querySelectorAll('[data-count]');
  const counterObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        animateCounter(e.target);
        counterObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  counterEls.forEach(el => counterObs.observe(el));

  function animateCounter(el) {
    const target = +el.dataset.count;
    const suffix = el.dataset.suffix || '';
    const duration = 1600;
    const start = performance.now();
    function frame(now) {
      const t = Math.min((now - start) / duration, 1);
      const ease = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.floor(ease * target) + suffix;
      if (t < 1) requestAnimationFrame(frame);
      else el.textContent = target + suffix;
    }
    requestAnimationFrame(frame);
  }

  // ── Interactive sliders ──
  const msgs = {
    low: "Low. AIKORSE is in standby mode. Enjoy the calm while it lasts.",
    mid: "Moderate. AIKORSE recommends 3–5 squeezes daily. Also maybe a walk.",
    high: "Elevated. Maximum grip force recommended. Have you tried breathing?",
    critical: "CRITICAL STRESS LEVEL. AIKORSE is being squeezed continuously. Please close Slack."
  };
  function updateScore() {
    const a = +document.getElementById('sl-anxiety').value;
    const f = +document.getElementById('sl-frustration').value;
    const d = +document.getElementById('sl-dread').value;
    const score = Math.round((a * 3.5 + f * 3 + d * 2.5) / 9 * 10);
    document.getElementById('val-anxiety').textContent = a;
    document.getElementById('val-frustration').textContent = f;
    document.getElementById('val-dread').textContent = d;
    document.getElementById('score-val').textContent = score;
    document.getElementById('score-bar').style.width = score + '%';
    let msg;
    if (score < 30) msg = msgs.low;
    else if (score < 55) msg = msgs.mid;
    else if (score < 78) msg = msgs.high;
    else msg = msgs.critical;
    document.getElementById('score-msg').textContent = msg;
  }
  ['sl-anxiety','sl-frustration','sl-dread'].forEach(id => {
    document.getElementById(id).addEventListener('input', updateScore);
  });

  // ── FAQ ──
  function toggleFaq(item) {
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  }

  // ── Tier switcher ──
  function setTier(btn) {
    document.querySelectorAll('.tier-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  // ── Nav progress ──
  window.addEventListener('scroll', () => {
    const progress = window.scrollY / (document.body.scrollHeight - window.innerHeight);
    document.querySelector('nav').style.borderBottomColor = `rgba(${Math.round(progress * 100 + 100)},${Math.round(progress * 200)},0,${Math.min(progress * 0.4, 0.3)})`;
  });
</script>
